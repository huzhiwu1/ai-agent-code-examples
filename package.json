{
  "name": "ai-agent-code-examples",
  "version": "1.0.0",
  "private": true,
  "description": "AI Agent 知识文章的代码示例库（monorepo，每篇文章一个独立包）",
  "workspaces": [
    "articles/*"
  ],
  "scripts": {
    "run:agentic-rag": "pnpm --filter @articles/agentic-rag run start",
    "run:memory": "pnpm --filter @articles/agent-memory run start",
    "run:context-eng": "pnpm --filter @articles/context-eng run start",
    "run:agent-observability": "pnpm --filter @articles/agent-observability run start",
    "run:mcp-tools": "pnpm --filter @articles/mcp-tools run start",
    "run:mcp-server-guide": "pnpm --filter @articles/mcp-server-guide run start",
    "run:mcp-adapters": "pnpm --filter @articles/mcp-adapters run start",
    "run:multi-agent-supervisor": "pnpm --filter @articles/multi-agent-supervisor run start",
    "run:multi-agent-supervisor:step1": "pnpm --filter @articles/multi-agent-supervisor run start:step1",
    "run:multi-agent-supervisor:step2": "pnpm --filter @articles/multi-agent-supervisor run start:step2",
    "run:multi-agent-supervisor:step3": "pnpm --filter @articles/multi-agent-supervisor run start:step3",
    "run:multi-agent-supervisor:step4": "pnpm --filter @articles/multi-agent-supervisor run start:step4",
    "run:multi-agent-supervisor:step5": "pnpm --filter @articles/multi-agent-supervisor run start:step5",
    "run:multi-agent-supervisor:step6": "pnpm --filter @articles/multi-agent-supervisor run start:step6",
    "run:multi-agent-supervisor:step7": "pnpm --filter @articles/multi-agent-supervisor run start:step7",
    "run:multi-agent-supervisor:step8": "pnpm --filter @articles/multi-agent-supervisor run start:step8",
    "run:multi-agent-supervisor:step9": "pnpm --filter @articles/multi-agent-supervisor run start:step9",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "run:planning": "pnpm --filter @articles/agent-planning run start",
    "run:planning:step1": "pnpm --filter @articles/agent-planning run start:step1",
    "run:planning:step2": "pnpm --filter @articles/agent-planning run start:step2",
    "run:planning:step3": "pnpm --filter @articles/agent-planning run start:step3",
    "run:planning:step4": "pnpm --filter @articles/agent-planning run start:step4",
    "run:planning:step5": "pnpm --filter @articles/agent-planning run start:step5",
    "run:planning:step6": "pnpm --filter @articles/agent-planning run start:step6",
    "run:planning:step7": "pnpm --filter @articles/agent-planning run start:step7",
    "run:pg-persistence": "pnpm --filter @articles/agent-pg-persistence run start",
    "pg:step:01": "pnpm --filter @articles/agent-pg-persistence run step:01",
    "pg:step:02": "pnpm --filter @articles/agent-pg-persistence run step:02",
    "pg:step:03": "pnpm --filter @articles/agent-pg-persistence run step:03",
    "pg:step:04": "pnpm --filter @articles/agent-pg-persistence run step:04",
    "pg:step:05": "pnpm --filter @articles/agent-pg-persistence run step:05",
    "pg:step:06": "pnpm --filter @articles/agent-pg-persistence run step:06",
    "pg:step:07": "pnpm --filter @articles/agent-pg-persistence run step:07"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0"
  },
  "packageManager": "pnpm@11.18.0"
}
