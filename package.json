{
  "name": "ai-agent-code-examples",
  "version": "1.0.0",
  "private": true,
  "description": "AI Agent 知识文章的代码示例库（monorepo，每篇文章一个独立包）",
  "workspaces": [
    "articles/*"
  ],
  "scripts": {
    "run:memory": "tsx articles/agent-memory/src/index.ts",
    "run:context-eng": "tsx articles/context-eng/src/index.ts",
    "run:agent-observability": "tsx articles/agent-observability/src/index.ts",
    "run:mcp-tools": "tsx articles/mcp-tools/src/index.ts",
    "run:mcp-server-guide": "tsx articles/mcp-server-guide/src/client.ts",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0"
  },
  "packageManager": "pnpm@11.18.0"
}
